<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon Condition="'$(Configuration)' == 'Release'">RoundedTB.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(Configuration)' != 'Release'">RoundedTBCanary.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="res\**" />
    <AvaloniaResource Include="*.ico" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\native\TaskbarPin\PrototypeController.cs" Link="Native\TaskbarPinController.cs" />
    <None Include="..\artifacts\native-pin\RoundedTB.TaskbarPin.dll" Link="Native\RoundedTB.TaskbarPin.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\artifacts\native-pin\RoundedTB.TaskbarPin.dll')" />
    <None Include="..\native\TaskbarPin\symbols\*.json" Link="Native\symbols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\native\TaskbarPin\vendor\minhook\LICENSE.txt" Link="Native\LICENSE-Minhook.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeTaskbarPin" BeforeTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('..\artifacts\native-pin\RoundedTB.TaskbarPin.dll')" Text="Build the native helper before publishing: RoundedTB.Tests/PowerShell/Build-TaskbarPinPrototype.ps1" />
  </Target>
  <Target Name="CopyRecoveryAppHost" AfterTargets="Build" Condition="Exists('$(TargetDir)RoundedTB.exe')">
    <Copy SourceFiles="$(TargetDir)RoundedTB.exe" DestinationFiles="$(TargetDir)RoundedTB.Recovery.exe" />
  </Target>
  <Target Name="PublishRecoveryAppHost" AfterTargets="Publish" Condition="Exists('$(PublishDir)RoundedTB.exe')">
    <Copy SourceFiles="$(PublishDir)RoundedTB.exe" DestinationFiles="$(PublishDir)RoundedTB.Recovery.exe" />
  </Target>
</Project>
